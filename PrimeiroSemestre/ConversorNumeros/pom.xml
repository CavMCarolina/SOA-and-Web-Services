<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven traz dependências externa, xml "controla" -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.fiap3espa</groupId>
    <artifactId>ConversorNumeros</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
       - Empacotamento tipo war -> web (mais leve, precisa adicionar servidor manualmente)
       - Empacotamento tipo jar -> automático (criar um executável, mais pesado)
    -->
    <packaging>jar</packaging>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.3</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- configuração do plugin para a conexão -->
                    <wsdlUrls>
                        <!-- URL Number -->
                        <wsdlUrl>https://www.dataaccess.com/webservicesserver/NumberConversion.wso?WSDL</wsdlUrl>

                        <!-- URL CEP -->
                        <!-- <wsdlUrl>https://apps.correios.com.br/SigepMasterJPA/AtendeClienteService/AtendeCliente?wsdl</wsdlUrl> -->
                    </wsdlUrls>
                    <keep>true</keep>
                    <packageName>br.com.fiap3espa.stub_classes</packageName>
                    <sourceDestDir>src/main/java</sourceDestDir>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Dependências para o pacote
       RT = pacote mais leve
       RI = pacote com o RT + algumas coisas que não vamos usar
     -->
    <dependencies>
        <!-- https://mvnrepository.com/artifact/com.sun.xml.ws/jaxws-rt -->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.3</version>
        </dependency>
    </dependencies>
</project>